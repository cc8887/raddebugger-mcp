+// Strict UTF-8: return a codepoint's byte count, or zero for malformed input.
+// Do not let permissive conversion or byte truncation hide invalid source data.
+internal U64
+ev_utf8_sequence_size(String8 string, U64 off)
+{
+  if(off >= string.size) { return 0; }
+  U8 *p = string.str+off;
+  U64 left = string.size-off;
+  if(p[0] <= 0x7f) { return 1; }
+  U64 count = 0;
+  if(0xc2 <= p[0] && p[0] <= 0xdf) { count = 2; }
+  else if(0xe0 <= p[0] && p[0] <= 0xef) { count = 3; }
+  else if(0xf0 <= p[0] && p[0] <= 0xf4) { count = 4; }
+  if(count == 0 || left < count) { return 0; }
+  for(U64 i = 1; i < count; i += 1)
+  {
+    if(p[i] < 0x80 || 0xbf < p[i]) { return 0; }
+  }
+  if((p[0] == 0xe0 && p[1] < 0xa0) || (p[0] == 0xed && p[1] >= 0xa0) ||
+     (p[0] == 0xf0 && p[1] < 0x90) || (p[0] == 0xf4 && p[1] >= 0x90)) { return 0; }
+  return count;
+}
+
+internal B32
+ev_utf8_is_valid(String8 string)
+{
+  for(U64 off = 0; off < string.size;)
+  {
+    U64 size = ev_utf8_sequence_size(string, off);
+    if(size == 0) { return 0; }
+    off += size;
+  }
+  return 1;
+}
+
+internal U64
+ev_utf8_prefix_size(String8 string, U64 cap)
+{
+  U64 off = 0;
+  for(;off < string.size;)
+  {
+    U64 size = ev_utf8_sequence_size(string, off);
+    if(size == 0 || size > cap-Min(cap, off)) { break; }
+    off += size;
+  }
+  return off;
+}
+
+// Read no more than the declared source codeunit count. Unknown-length pointers
+// are read one codeunit at a time, so a NUL at a page boundary never over-reads.
+internal String8
+ev_string_from_encoded_eval(Arena *arena, E_Eval eval, EV_StringParams *params,
+                            E_Type *type, U64 address, U64 element_size)
+{
+  U64 unit_size = element_size == 2 || element_size == 4 ? element_size : 1;
+  B32 bounded = params->limit_strings || type->kind == E_TypeKind_Array;
+  U64 declared_units = params->limit_strings ? params->limit_strings_size : type->count;
+  U64 unit_cap = 4096/unit_size;
+  B32 inline_value = type->kind == E_TypeKind_Array && eval.irtree.mode == E_Mode_Value;
+  if(inline_value) { unit_cap = Min(unit_cap, sizeof(eval.value.u512.u8)/unit_size); }
+  U64 units = bounded ? Min(declared_units, unit_cap) : unit_cap;
+  U8 *buffer = push_array(arena, U8, units*unit_size);
+  B32 terminated = 0;
+  B32 read_good = 1;
+  if(inline_value)
+  {
+    MemoryCopy(buffer, eval.value.u512.u8, units*unit_size);
+  }
+  else if(bounded && units != 0)
+  {
+    U64 bytes = units*unit_size;
+    read_good = address <= max_U64-bytes && e_space_read(eval.space, buffer, 0, r1u64(address, address+bytes));
+  }
+  else if(!bounded)
+  {
+    for(U64 i = 0; i < units; i += 1)
+    {
+      U64 off = i*unit_size;
+      if(address > max_U64-off || address+off > max_U64-unit_size ||
+         !e_space_read(eval.space, buffer+off, 0, r1u64(address+off, address+off+unit_size)))
+      {
+        read_good = 0;
+        break;
+      }
+      U32 unit = 0;
+      MemoryCopy(&unit, buffer+off, unit_size);
+      if(unit == 0) { units = i; terminated = 1; break; }
+    }
+  }
+  if(!read_good)
+  {
+    if(params->status) { params->status->read_failed = 1; }
+    return str8_lit("<unreadable string>");
+  }
+  for(U64 i = 0; i < units; i += 1)
+  {
+    U32 unit = 0;
+    MemoryCopy(&unit, buffer+i*unit_size, unit_size);
+    if(unit == 0) { units = i; terminated = 1; break; }
+  }
+  B32 cut = !terminated && (!bounded || declared_units > unit_cap);
+  if(cut && params->status) { params->status->truncated = 1; }
+  U8 *out = push_array(arena, U8, units*4+1);
+  U64 out_size = 0;
+  B32 valid = 1;
+  for(U64 i = 0; i < units;)
+  {
+    U32 cp = 0;
+    MemoryCopy(&cp, buffer+i*unit_size, unit_size);
+    if(unit_size == 1)
+    {
+      String8 source = str8(buffer, units);
+      U64 size = ev_utf8_sequence_size(source, i);
+      if(size == 0)
+      {
+        // A byte budget may split an otherwise valid final UTF-8 sequence.
+        U64 need = (0xc2 <= cp && cp <= 0xdf) ? 2 :
+                   (0xe0 <= cp && cp <= 0xef) ? 3 : (0xf0 <= cp && cp <= 0xf4) ? 4 : 0;
+        if(cut && need > units-i)
+        {
+          B32 partial_valid = 1;
+          for(U64 j = i+1; j < units; j += 1)
+          {
+            if(buffer[j] < 0x80 || 0xbf < buffer[j]) { partial_valid = 0; }
+          }
+          if(i+1 < units &&
+             ((cp == 0xe0 && buffer[i+1] < 0xa0) || (cp == 0xed && buffer[i+1] >= 0xa0) ||
+              (cp == 0xf0 && buffer[i+1] < 0x90) || (cp == 0xf4 && buffer[i+1] >= 0x90)))
+          {
+            partial_valid = 0;
+          }
+          if(partial_valid) { break; }
+        }
+        valid = 0; break;
+      }
+      MemoryCopy(out+out_size, buffer+i, size);
+      out_size += size;
+      i += size;
+      continue;
+    }
+    i += 1;
+    if(unit_size == 2 && 0xd800 <= cp && cp <= 0xdbff)
+    {
+      if(i == units && cut) { break; }
+      U16 low = 0;
+      if(i < units) { MemoryCopy(&low, buffer+i*2, 2); }
+      if(i == units || low < 0xdc00 || 0xdfff < low) { valid = 0; break; }
+      cp = 0x10000 + ((cp-0xd800)<<10) + (low-0xdc00);
+      i += 1;
+    }
+    else if((0xd800 <= cp && cp <= 0xdfff) || cp > 0x10ffff) { valid = 0; break; }
+    out_size += utf8_encode(out+out_size, cp);
+  }
+  if(!valid)
+  {
+    if(params->status) { params->status->invalid_encoding = 1; }
+    return str8_lit("<invalid encoding>");
+  }
+  return str8(out, out_size);
+}
